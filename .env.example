# 실제 값은 .env에만 둔다 (커밋 금지). 아래는 형식 예시이며 <...>를 채운다.

# LLM (infra/llm/start_llm.sh 기준)
LLM_BASE_URL=http://<host>:<port>/v1
LLM_MODEL=<server alias>
LLM_MAX_CONCURRENCY=<n>        # 서버 /props의 total_slots 값 이하
LLM_REQUEST_TIMEOUT=<seconds>

# 번역 후보 모델 (배치 미확정)
MT_BASE_URL=http://<host>:<port>/v1
MT_MODEL=<server alias>
MT_MAX_CONCURRENCY=<n>
LLM_MODEL_QUANT=<quantization, e.g. Q4_K_M>

# 임베딩
EMB_BASE_URL=http://<host>:<port>/v1
EMB_MODEL=<server alias>

# 수집
# UA는 크롤러 표준 형식 고정 문자열. 다른 크롤러 사칭·브라우저 위장·로테이션 금지 (validate_user_agent()가 검사)
# 형식: "Mozilla/5.0 (compatible; <BotToken>/<version>; +<bot info URL>)"
CRAWL_BOT_TOKEN=<BotToken>
CRAWL_USER_AGENT="Mozilla/5.0 (compatible; <BotToken>/<version>; +<bot info URL>)"
# 도메인별 요청 간격: [MIN, MAX] 균등분포 랜덤 (MIN >= 1). robots Crawl-delay가 더 길면 그 값
CRAWL_MIN_DELAY_SEC=<seconds>
CRAWL_MAX_DELAY_SEC=<seconds>
CRAWL_MAX_RETRIES=<n>
CRAWL_TIMEOUT_SEC=<seconds>
# 도메인별 잠금·다음 허용 시각·robots 캐시 디렉터리 (프로세스 간 공유)
CRAWL_STATE_DIR=<path>
# 도메인별 간격·타임아웃 host=min:max:timeout, 쉼표 구분 (기본값보다 느슨하게만 적용)
CRAWL_DOMAIN_OVERRIDES=<host>=<min>:<max>:<timeout>

# 저장
RAW_DIR=<path>
MIN_FREE_GB=<GB>
# 수집 경로와 분리된 백업 대상 (NAS, 외장 디스크 등). 비우면 백업 생략 경고
BACKUP_DIR=<path>
DB_PATH=<path>.duckdb
LLM_CACHE_DIR=<path>
