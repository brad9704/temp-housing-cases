# LLM (infra/llm/start_llm.sh 기준)
LLM_BASE_URL=http://localhost:8005/v1
LLM_MODEL=gemma-4-31b
LLM_MAX_CONCURRENCY=4          # 서버 로그의 n_slots 값으로 교체할 것
LLM_REQUEST_TIMEOUT=600

# 번역 후보 (Gemma-4-26B-A4B MoE, Q4_K_M). 배치 미확정
MT_BASE_URL=http://localhost:8007/v1
MT_MODEL=gemma-4-26b-a4b
MT_MAX_CONCURRENCY=4
LLM_MODEL_QUANT=Q4_K_M

# 임베딩 (기동 스크립트 미확정)
EMB_BASE_URL=http://localhost:8006/v1
EMB_MODEL=qwen3-embedding-8b

# 수집
# UA는 크롤러 표준 형식(구글봇과 같은 형식, 이름은 자체 봇). 다른 크롤러 사칭·브라우저 위장·로테이션 금지
# 정보 URL을 붙이려면: "Mozilla/5.0 (compatible; UNISTDisasterHousingBot/0.1; +https://...)"
CRAWL_BOT_TOKEN=UNISTDisasterHousingBot
CRAWL_USER_AGENT="Mozilla/5.0 (compatible; UNISTDisasterHousingBot/0.1)"
# 도메인별 요청 간격: [MIN, MAX] 균등분포 랜덤. robots Crawl-delay가 더 길면 그 값
CRAWL_MIN_DELAY_SEC=2
CRAWL_MAX_DELAY_SEC=5
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_SEC=30
# 도메인별 잠금·다음 허용 시각·robots 캐시 (프로세스 간 공유). 비우면 프로세스 내부만
CRAWL_STATE_DIR=data/cache/crawl_state
# 도메인별 간격·타임아웃 host=min:max:timeout (기본값보다 느슨하게만 적용). Wayback CDX는 분당 약 15회 한도로 알려짐
CRAWL_DOMAIN_OVERRIDES=web.archive.org=5:8:120

# 저장
RAW_DIR=data/raw
MIN_FREE_GB=100
# 수집 경로와 분리된 백업 대상 (NAS, 외장 디스크 등). 비우면 백업 생략 경고
BACKUP_DIR=
DB_PATH=data/db/cases.duckdb
LLM_CACHE_DIR=data/cache
